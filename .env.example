# ═══ Firebase (Dev 1 manages) ═══
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ═══ GitHub OAuth (Dev 4 manages) ═══
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ═══ Yjs collaboration server (Dev 3 manages) ═══
# URL of the standalone Yjs WebSocket server (see server/README.md).
# Default: ws://localhost:1234 — run `cd server && npm run dev` locally.
# Production: wss://your-yjs-host.example.com
NEXT_PUBLIC_YJS_WS_URL=ws://localhost:1234

# ═══ App Config ═══
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ═══ AI Coding Agent (Gemini) ═══
# Server-only. The key is never exposed to the client; all LLM calls are
# proxied through POST /api/sessions/[id]/agent. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the default model. See https://ai.google.dev/models
GEMINI_MODEL=gemini-2.5-flash
